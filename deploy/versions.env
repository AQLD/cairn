# Pinned versions for every Cairn host: local dev VMs, DigitalOcean test
# droplets and, later, production. Change a version here and nowhere else;
# say why in the commit message.

# Ubuntu release (the DigitalOcean image slug and the local VM image must match)
UBUNTU_RELEASE=24.04
DO_IMAGE=ubuntu-24-04-x64

# gVisor release folder under https://storage.googleapis.com/gvisor/releases/release/
RUNSC_RELEASE=20261005
# Older releases installed next to it (space-separated). A full save, and so a
# paused workspace, restores only with the release that made it: when upgrading,
# move the old RUNSC_RELEASE here. Releases before 20261005 do not restore
# sleeping processes correctly, so there is nothing to keep yet.
RUNSC_KEEP=

# Go toolchain (to build and test cairn on the host)
GO_VERSION=1.26.5
